# Copy this file to .env and fill in the values. Never commit .env.

# Chatwoot (Application API)
CHATWOOT_BASE_URL=https://app.chatwoot.com
CHATWOOT_ACCOUNT_ID=
CHATWOOT_API_TOKEN=
# The dedicated API inbox that receives the historical messages. NEVER the WhatsApp inbox.
CHATWOOT_ARCHIVE_INBOX_ID=
# The script refuses to run if the inbox with that ID is not an API inbox with exactly this name.
CHATWOOT_ARCHIVE_INBOX_NAME=Respond.io Archive

# Timezone of the "Date & Time" columns in the respond.io exports (IANA name).
# The analysis stage verifies this against WhatsApp timestamps embedded in the export.
SOURCE_TIMEZONE=Asia/Dubai

# Folders (relative to the project folder unless absolute)
DATA_DIR=data
MEDIA_DIR=media
OUTPUT_DIR=output

# Pacing / limits
REQUESTS_PER_MINUTE=240
CONVERSATION_MESSAGES_PER_MINUTE=150
HTTP_TIMEOUT_SECONDS=60
MEDIA_TIMEOUT_SECONDS=120

# Chatwoot cannot back-date messages. Set to true to prefix every imported message
# with its original date/time so it is visible in the conversation view.
TIMESTAMP_PREFIX=false
